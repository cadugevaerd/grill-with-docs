{
  "schema": "workflow-tier-models/v1",
  "workflow_version": "v4",
  "binding_version": "1",
  "tier_order": ["small", "medium", "large"],
  "actor_classes": {
    "leader": {"frontier_allowed": true},
    "worker": {"frontier_allowed": false}
  },
  "runtimes": {
    "claude": {
      "resolved": true,
      "adapter": "claude-code-skill/v1",
      "selection": "subagent model parameter",
      "tiers": {
        "small": {"model": "haiku", "frontier": false},
        "medium": {"model": "sonnet", "frontier": false},
        "large": {"model": "opus", "frontier": true}
      }
    },
    "codex": {
      "resolved": true,
      "adapter": "codex-skill/v1",
      "selection": "codex -m <model>; family resolved to the lowest-priority slug in $CODEX_HOME/models_cache.json",
      "tiers": {
        "small": {"family": "luna", "frontier": false},
        "medium": {"family": "terra", "frontier": false},
        "large": {"family": "sol", "frontier": true}
      }
    },
    "hermes": {
      "resolved": false,
      "unresolved_reason": "RUNTIME_ENTRYPOINT_UNPROVEN"
    }
  }
}
